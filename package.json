{
  "name": "mailtrace-ai-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
