{
  "name": "mailtrace-ai-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm --prefix server install --include=dev && (npm --prefix server run build || true)",
    "start": "node server/dist/index.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "dependencies": {
    "concurrently": "^10.0.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
